{% assign figures = site.data.biochemistry_figures | where: 'slug', include.slug %}
{% if figures.size > 0 %}
  <div class="biochemistry-figure-grid" aria-label="Illustrated reference for {{ include.title }}">
    {% for figure in figures %}
      <figure>
        <a href="{{ figure.path | relative_url }}" class="venobox" data-gall="{{ include.slug }}-figures">
          <img
            src="{{ figure.path | relative_url }}"
            loading="lazy"
            alt="{{ figure.alt }}"
          >
        </a>
        <figcaption>Figure {{ figure.figure }} · {{ figure.caption }}</figcaption>
      </figure>
    {% endfor %}
  </div>
{% endif %}
